{
  "name": "@bratel/dgit",
  "version": "1.0.0",
  "description": "@bratel git download application",
  "publishConfig": {
    "access": "public"
  },
  "author": "JohnApache",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lsq/dgit"
  },
  "keywords": [
    "dgit",
    "github download tool"
  ],
  "main": "./lib/dgit.js",
  "types": "./lib/dgit.d.ts",
  "bin": {
    "dgit": "./bin/cmd.js"
  },
  "scripts": {
    "prepare": "husky",
    "build:ts": "tsc --build",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --ext .jsx --ext .js --ext .tsx --ext .ts --cache --fix",
    "test:mocha": "npm run build:ts && nyc --reporter=text mocha --require ts-node/register test/**/*.{ts,tsx} -t 60000",
    "test:mocha:reporter": "nyc --reporter=lcov --reporter=text mocha --require ts-node/register test/**/*.{ts,tsx} -t 60000 --reporter=mochawesome",
    "watch:ts": "tsc --watch",
    "prepublishOnly": "npm run test:mocha && npm run lint && npm run build:ts"
  },
  "dependencies": {
    "@types/async": "^3.2.26",
    "@types/progress": "^2.0.7",
    "async": "^3.2.6",
    "axios": "^1.21.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "inquirer": "^14.2.5",
    "ora": "^10.0.0",
    "progress": "^2.0.3",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.1",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "request": {
      "form-data": "^4.0.4",
      "tough-cookie": "^4.1.3"
    }
  },
  "resolutions": {
    "form-data": "^4.0.4",
    "tough-cookie": "^4.1.3"
  },
  "lint-staged": {
    "**/*.{jsx,js}": [
      "npm run lint",
      "npm run lint:fix",
      "git add --all"
    ]
  }
}
